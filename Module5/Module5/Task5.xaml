<Window x:Class="Module5.Task5" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Калькулятор" Height="300" Width="250">
    <DockPanel>
        <TextBox Name="txt" DockPanel.Dock="Top" FontSize="24" TextAlignment="Right" IsReadOnly="True" Height="40"/>
        <UniformGrid Columns="4" ButtonBase.Click="Btn_Click">
            <Button Content="7"/>
            <Button Content="8"/>
            <Button Content="9"/>
            <Button Content="/"/>
            <Button Content="4"/>
            <Button Content="5"/>
            <Button Content="6"/>
            <Button Content="*"/>
            <Button Content="1"/>
            <Button Content="2"/>
            <Button Content="3"/>
            <Button Content="-"/>
            <Button Content="C"/>
            <Button Content="0"/>
            <Button Content="="/>
            <Button Content="+"/>
        </UniformGrid>
    </DockPanel>
</Window>