<Window x:Class="Module5.Task3" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Задачи" Height="300" Width="300">
    <DockPanel Margin="5">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
            <TextBox Name="txtTask" Width="140" Margin="0,0,5,0"/>
            <Button Content="Добавить" Click="Add" Width="60" Margin="0,0,5,0"/>
            <Button Content="Удалить" Click="Del" Width="60"/>
        </StackPanel>
        <ListBox Name="lbTasks">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>