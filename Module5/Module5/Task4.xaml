<Window x:Class="Module5.Task4" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Просмотр" Height="400" Width="500">
    <DockPanel>
        <Button DockPanel.Dock="Top" Content="Открыть изображение" Click="Open_Click" Padding="5"/>
        <Slider DockPanel.Dock="Bottom" Name="zoom" Minimum="0.1" Maximum="5" Value="1" Margin="10"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image Name="img">
                <Image.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Value, ElementName=zoom}" ScaleY="{Binding Value, ElementName=zoom}"/>
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>
    </DockPanel>
</Window>