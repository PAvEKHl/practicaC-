<Window x:Class="Module3.Task5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 5 - Сортировка" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Введите числа через запятую:" Margin="0,0,0,5"/>
            <TextBox x:Name="NumbersTextBox" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <Button Content="Сортировать" Height="30" Click="SortButton_Click" Margin="0,0,0,10"/>

            <ComboBox x:Name="SortMethodSelector" Margin="0,0,0,10" SelectedIndex="0">
                <ComboBoxItem Content="От меньшего к большему" />
                <ComboBoxItem Content="От большего к меньшему" />
            </ComboBox>

            <TextBlock Text="Отсортированные данные:" FontWeight="Bold" Margin="0,10,0,5" />
            <TextBox x:Name="ResultTextBox" Height="30" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>